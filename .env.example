# ===== 后端（服务端类型 AK/SK，来自百度地图开放平台-应用管理）=====
# 切勿把真实密钥提交进仓库！复制本文件为 .env 后填写
BMAP_SERVER_AK=你的服务端AK
BMAP_SERVER_SK=

# 限流与并发（个人 AK 建议 QPS<=3）
BMAP_QPS=3
BMAP_CONCURRENCY=4

# 等时圈参数
ISOCHRONE_RAYS=24
ISOCHRONE_RADII=300,600,900,1200,1500,1800
ISOCHRONE_TARGET_SEC=900

# 演示模式：1 = 不调真实 API，本地生成模拟数据
BMAP_MOCK=0

SAMPLE_CITY=北京市

# ===== 规划智能体（OpenAI 兼容接口，默认对接 DeepSeek）=====
# 留空则自动降级为规则模式：固定编排 + 确定性文案，不调用任何大模型
LLM_API_KEY=你的大模型APIKey
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 百度千帆个人 Token 套餐示例（key 只能走该路径，模型需在套餐清单内）：
#   LLM_BASE_URL=https://qianfan.baidubce.com/v2/tokenplan/personal
#   LLM_MODEL=deepseek-v4.1-flash
# 单轮对话内允许的工具调用轮数上限（防止无限循环与配额失控）
AGENT_MAX_STEPS=4

# ===== 前端（浏览器端类型 AK，构建时注入）=====
VITE_BMAP_AK=你的浏览器端AK
