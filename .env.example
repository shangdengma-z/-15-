# ===== 后端（服务端类型 AK/SK，来自百度地图开放平台-应用管理）=====

BMAP_SERVER_AK=你的服务端AK
BMAP_SERVER_SK=

# 限流与并发（百度按服务分别计：本账号路线规划 30 QPS / 1 万次每天，地点检索 30 QPS）
# 个人 AK 低配额档实测并发≥4 就会返回 401；客户端有 0.5s 起指数退避兜住，
# 若你仍频繁看到 401，把 BMAP_CONCURRENCY 调回 3 即可（QPS 不用动，令牌桶会自己排队）
BMAP_QPS=30
BMAP_CONCURRENCY=10
BMAP_PLACE_QPS=25
BMAP_PLACE_CONCURRENCY=8
BMAP_GEO_QPS=8
BMAP_GEO_CONCURRENCY=4

# 等时圈参数（调用数 = RAYS x 半径档数，直接决定冷跑时长；精度优先可回 24 / 6 档）
ISOCHRONE_RAYS=18
ISOCHRONE_RADII=300,600,1000,1500
ISOCHRONE_TARGET_SEC=900

# 盲区识别规模：核验候选点数与每类比对的最近 POI 个数（步行配额的主要消耗项）
BLINDSPOT_MAX_CANDIDATES=8
BLINDSPOT_VERIFY_NEAREST=3

# 演示模式：1 = 不调真实 API，本地生成模拟数据
BMAP_MOCK=0

# 缓存与历史库路径（相对启动目录；compose 已把这两个目录挂到 ./data 下）
# 缓存按 mock_/real_ 前缀分家，历史库 SQLite 存派生结果、不含百度原始响应
BMAP_CACHE_DIR=data/cache
BMAP_DB_PATH=data/db/lifestyle.db

SAMPLE_CITY=北京市

# ===== 规划智能体（OpenAI 兼容接口，默认对接 DeepSeek）=====
# 留空则自动降级为规则模式：固定编排 + 确定性文案，不调用任何大模型
LLM_API_KEY=你的大模型APIKey
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 百度千帆个人 Token 套餐示例（key 只能走该路径，模型需在套餐清单内）：
#   LLM_BASE_URL=https://qianfan.baidubce.com/v2/tokenplan/personal
#   LLM_MODEL=deepseek-v4.1-flash
# 单轮对话内允许的工具调用轮数上限（防止无限循环与配额失控）
AGENT_MAX_STEPS=4

# ===== 多用户上线（默认关闭：不设这些项就是单机版）=====
# AUTH_ENABLED=1 才启用注册/登录与按用户隔离；0 时以下项全部忽略
AUTH_ENABLED=0
# sqlite（单机默认）| mysql（上线推荐；MySQL 8.0，utf8mb4）
DB_BACKEND=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=circle15
DB_USER=circle
DB_PASSWORD=你的库口令
# SECRET_KEY 签会话 cookie；MASTER_KEY 只用于"用户主动勾选加密保存"的 AK。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(32))"
SECRET_KEY=随机32字节串
MASTER_KEY=随机32字节串
SESSION_DAYS=14
# 开放注册的护栏：每 IP 每日注册数、每人每日分析次数、全局并发任务数
MAX_REG_PER_IP_DAY=5
DAILY_ANALYSIS_BUDGET=30
JOB_SLOTS=4
# 跨域白名单。走 nginx 同源部署时前后端同一个域名，这项留默认 * 也不会被浏览器用于携带 cookie；
# 如果前端单独部署在别的域名上，必须写成具体 origin（逗号分隔），否则会话 cookie 发不出去。
CORS_ORIGINS=*
# 上线时不要把真实 AK 写在这里：多用户模式下每个用户填自己的 AK，
# 默认只存在他自己的浏览器里（勾选"加密保存到本账户"才入库）。
BMAP_SERVER_AK=

# ===== 前端（浏览器端类型 AK，构建时注入）=====
VITE_BMAP_AK=你的浏览器端AK
