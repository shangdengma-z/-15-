# ===== 后端（服务端类型 AK/SK，来自百度地图开放平台-应用管理）=====

BMAP_SERVER_AK=你的服务端AK
BMAP_SERVER_SK=

# 限流与并发（百度个人 AK 按服务分别计：步行路线规划(轻量) 3 QPS、地点检索 30 QPS）
# 步行是全项目唯一的吞吐瓶颈，QPS 提上去只会换来 401
BMAP_QPS=3
BMAP_CONCURRENCY=3
BMAP_PLACE_QPS=25
BMAP_PLACE_CONCURRENCY=8
BMAP_GEO_QPS=8
BMAP_GEO_CONCURRENCY=4

# 等时圈参数（调用数 = RAYS x 半径档数，直接决定冷跑时长；精度优先可回 24 / 6 档）
ISOCHRONE_RAYS=18
ISOCHRONE_RADII=300,600,1000,1500
ISOCHRONE_TARGET_SEC=900

# 盲区识别规模：核验候选点数与每类比对的最近 POI 个数（步行配额的主要消耗项）
BLINDSPOT_MAX_CANDIDATES=8
BLINDSPOT_VERIFY_NEAREST=3

# 演示模式：1 = 不调真实 API，本地生成模拟数据
BMAP_MOCK=0

SAMPLE_CITY=北京市

# ===== 规划智能体（OpenAI 兼容接口，默认对接 DeepSeek）=====
# 留空则自动降级为规则模式：固定编排 + 确定性文案，不调用任何大模型
LLM_API_KEY=你的大模型APIKey
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 百度千帆个人 Token 套餐示例（key 只能走该路径，模型需在套餐清单内）：
#   LLM_BASE_URL=https://qianfan.baidubce.com/v2/tokenplan/personal
#   LLM_MODEL=deepseek-v4.1-flash
# 单轮对话内允许的工具调用轮数上限（防止无限循环与配额失控）
AGENT_MAX_STEPS=4

# ===== 前端（浏览器端类型 AK，构建时注入）=====
VITE_BMAP_AK=你的浏览器端AK
