# 2C2G 单机的 MySQL 8.0 配置：本项目只有 4 张表（users/sessions/quotas/rate_log），
# 默认配置的 MySQL 8 在这台机器上会因为 performance_schema + binlog 直接吃掉一半内存。
[mysqld]
# 一项就省 300~500M。本项目不做查询诊断，不需要它
performance_schema = OFF
# 单节点应用库，没有从库要回放；关掉省内存也省磁盘写
skip-log-bin
skip-name-resolve

innodb_buffer_pool_size = 256M
innodb_redo_log_capacity = 64M
innodb_flush_method = O_DIRECT
# 会话/配额是"丢了也能重建"的数据，2 秒刷一次盘换 I/O 是划算的
innodb_flush_log_at_trx_commit = 2

# 后端连接池很小（每个请求一条短连接），40 足够，留余地给备份脚本
max_connections = 40
table_open_cache = 400
thread_cache_size = 8
tmp_table_size = 16M
max_heap_table_size = 16M

character_set_server = utf8mb4
collation_server = utf8mb4_0900_ai_ci

[client]
default-character-set = utf8mb4
