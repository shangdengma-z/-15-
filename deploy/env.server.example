# 服务器上的 .env 模板：拷到服务器后改名 .env，只填尖括号里的值。
#   scp deploy/env.server.example user@host:/srv/bisai/.env
#   ssh user@host  →  chmod 600 /srv/bisai/.env         （这文件里有口令级内容，别留在别的用户可读的位置）
# 这份文件本身不含任何真实密钥，可以进仓库；真密钥只存在于服务器那一份 .env 里，
# 既不进 git（.gitignore 已排除），也不进镜像（.dockerignore 已排除）。
#
# 本地已经有一份填好真实 AK 的 `deploy/env.server`（被 .gitignore 排除，不会提交）：
#   scp deploy/env.server root@<服务器IP>:/srv/bisai/.env
# 注意：--env-file 是**创建容器时**读进去的，改完 .env 要 docker rm -f 再 docker run，restart 无效。

# ===== 数据源：百度地图开放平台 =====
# 部署级兜底 AK：留着它，访客不填 AK 也能跑真实路网，用量记在你账上。
# 必须同时在百度控制台把【服务器公网 IP】加进这个 AK 的白名单，否则云上第一个请求就 403。
# 应用开了 SN 校验才需要填 SK，没开就留空。
BMAP_SERVER_AK=<你的服务端AK>
BMAP_SERVER_SK=
# 路线规划 30 QPS / 1 万次每天（2026-10 档位）；突发 401 靠退避重试，别把并发拉满
BMAP_QPS=30
BMAP_CONCURRENCY=10
BMAP_PLACE_QPS=25
BMAP_PLACE_CONCURRENCY=8
BMAP_GEO_QPS=8
BMAP_GEO_CONCURRENCY=4

# ===== 采样与盲区（一般不用改）=====
BMAP_MOCK=0
ISOCHRONE_RAYS=18
ISOCHRONE_RADII=300,600,1000,1500
ISOCHRONE_TARGET_SEC=900
SAMPLE_CITY=北京市
BLINDSPOT_MAX_CANDIDATES=16
BLINDSPOT_VERIFY_NEAREST=3

# ===== 容器内路径：WORKDIR 是 /srv，data 目录要 -v 挂出来，否则删容器就丢档案 =====
BMAP_CACHE_DIR=data/cache
BMAP_DB_PATH=data/db/lifestyle.db

# ===== 账号与门禁 =====
AUTH_ENABLED=1
# sqlite：账号四张表与档案在同一个文件里，一台 2C2G 不需要再跑 MySQL
# （要换成 MySQL 就填 mysql 并把下面 DB_* 补齐，MySQL 装宿主机比装容器省内存）
DB_BACKEND=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=circle15
DB_USER=circle
DB_PASSWORD=
# 会话 cookie 的签名密钥 + 账户内加密存 AK 的主密钥。各生成一个：
#   openssl rand -base64 32
# 注意：MASTER_KEY 换了会让已勾"加密保存到本账户"的用户 AK 解不开（只能让他重填一次）
SECRET_KEY=<随机32字节串>
MASTER_KEY=<随机32字节串>
SESSION_DAYS=14
# 每人每日次数上限已去掉（一次体检约 183 次路线规划调用，但按人设上限挡不住真烧的人）。
# 兜共享 AK 的那道防线改成了：百度控制台的 IP 白名单 + 每 IP 注册限速 + JOB_SLOTS 并发闸；
# data/db 里的 quotas 表仍按人按天记用量，事后想收紧就查它。
MAX_REG_PER_IP_DAY=5
JOB_SLOTS=4
# 同源部署（页面和 /api 同一个域名）时这项保持 *；前端另行部署才填具体 origin
CORS_ORIGINS=*

# ===== 大模型：上线实例请留空 =====
# 留空 = 智能体自动回落规则模式；想用 AI 助手的访客在「接入设置」里填自己的 key，
# 默认只存在他自己的浏览器里（勾选"加密保存到本账户"才 Fernet 加密入库）。
# 按 token 计费且没有额度条可看，所以这份 key 不该由你替所有人出。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
AGENT_MAX_STEPS=4

# ===== 前端：浏览器端地图 AK =====
# 运行时由后端 /env.js 注进页面，改它只需重启容器，不必重新构建镜像。
# 它本来就是公开物（页面源码可见），真正的约束是控制台里的 Referer 白名单：
# 没域名就填 http://<服务器IP>:8080/* ，有域名再补 https://域名/*
VITE_BMAP_AK=<你的浏览器端AK>
