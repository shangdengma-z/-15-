# 构建上下文瘦身 + 密钥防泄漏（compose 的 context 是仓库根目录，两个服务共用本文件）
.git
.gitignore
.venv
backend/.venv
**/__pycache__
**/*.pyc

# 密钥文件绝不进镜像构建上下文
.env
frontend/.env.local
frontend/.env

# 本地依赖与产物（镜像内会重新安装/构建）
frontend/node_modules
node_modules
frontend/dist

# 缓存与演示素材不需要进镜像（缓存/历史库通过 volume 挂载）
data/cache
data/db
data/sample
赛题要求与技术栈_*.md
*.pdf
.vscode
.github
